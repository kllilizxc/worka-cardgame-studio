  "relations": [
    {
      "key": "ideas-todo",
      "name": "点子 → 制作",
      "goal": "用户要求实施的点子直接交给制作待办，开工时带上相关旧点子。保存点子只收录原话。",
      "enabled": true,
      "nodeKeys": [
        "ideas",
        "todo"
      ],
      "source": {
        "path": "connections/ideas-todo"
      },
      "subscriptions": [
        {
          "nodeKey": "todo",
          "events": [
            "items.delegationRequested",
            "items.sessionLinked"
          ]
        }
      ]
    },
    {
      "key": "content-todo",
      "name": "内容便笺 → 制作",
      "goal": "要先试玩或涉及多种内容的请求，连同所指记录一起交给一个制作事项，由同一会话交付并接收反馈。",
      "enabled": true,
      "nodeKeys": [
        "story",
        "map",
        "encounter",
        "cards",
        "monsters",
        "people",
        "shop",
        "media",
        "todo"
      ],
      "source": {
        "path": "connections/content-todo"
      },
      "subscriptions": []
    },
    {
      "key": "delivery",
      "name": "制作 → 试玩",
      "goal": "改动提交后，登记从受影响场景或战斗直接启动的可试玩构建，并把试玩链接发到制作事项对话中。",
      "enabled": true,
      "nodeKeys": [
        "todo",
        "preview"
      ],
      "recipe": "desk-preview"
    },
    {
      "key": "playtest-todo",
      "name": "试玩 → 制作",
      "goal": "明确的修改要求或针对已试玩版本的反馈回到同一制作事项会话；笼统感想留在点子库。用户回复 OK 即合入确认版，按绑定仓库的推送配置同步并完成该事项。",
      "enabled": true,
      "nodeKeys": [
        "preview",
        "todo"
      ],
      "source": {
        "path": "connections/playtest-todo"
      },
      "subscriptions": []
    },
    {
      "key": "references",
      "name": "内容引用",
      "goal": "根据每条记录自身的引用实时计算记录之间的关联导航。",
      "enabled": true,
      "nodeKeys": [
        "story",
        "map",
        "encounter",
        "cards",
        "monsters",
        "people",
        "shop",
        "media"
      ],
      "source": {
        "path": "connections/references"
      },
      "subscriptions": []
    }
  ],
